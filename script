-- LOADING STEPS
local steps = {
	"Booting core...",
	"Loading interface...",
	"Applying glass UI...",
	"Syncing modules...",
	"Optimizing visuals...",
	"MFHUB Ready"
}

for i,v in ipairs(steps) do
	Status.Text = v

	TweenService:Create(Bar, TweenInfo.new(0.6, Enum.EasingStyle.Sine), {
		Size = UDim2.new(i/#steps,0,1,0)
	}):Play()

	wait(0.8)
end

