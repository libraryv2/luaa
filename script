-- ⚡ MFHUB LIGHTNING EFFECT (READY TO PASTE)

local TweenService = game:GetService("TweenService")

-- hanapin existing GUI
local Gui = game.CoreGui:FindFirstChild("MFHUBLoader")
if not Gui then return end

-- overlay layer
local Lightning = Instance.new("Frame")
Lightning.Name = "LightningFX"
Lightning.Parent = Gui
Lightning.Size = UDim2.new(1,0,1,0)
Lightning.BackgroundColor3 = Color3.fromRGB(255,255,255)
Lightning.BackgroundTransparency = 1
Lightning.ZIndex = 999

-- flash function
local function Flash()
	Lightning.BackgroundTransparency = 1

	-- quick flash in (white/blue tint feel)
	Lightning.BackgroundColor3 = Color3.fromRGB(255,255,255)

	TweenService:Create(Lightning, TweenInfo.new(0.05), {
		BackgroundTransparency = 0.65
	}):Play()

	task.wait(0.06)

	TweenService:Create(Lightning, TweenInfo.new(0.25), {
		BackgroundTransparency = 1
	}):Play()
end

-- optional: test flash agad (para makita mo gumagana)
task.delay(1, function()
	Flash()
end)

-- random lightning loop
task.spawn(function()
	while Gui and Gui.Parent do
		task.wait(math.random(2,5))

		if math.random(1,100) <= 40 then
			Flash()
		end
	end
end)
